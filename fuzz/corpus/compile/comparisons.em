fn main() {
    print(1 < 2);
    print(2 <= 2);
    print(3 > 4);
    print(1 == 1 && 2 != 3);
    print("abc" < "abd");
    print("b" > "abc");
    print("" < "a");
    print("same" == "same");
    print(true == false);
    print(() == ());
    print(0.0 / 0.0 == 0.0 / 0.0);
    print(!true || false);
}
