fn main() {
    print(1 + 2 * 3);
    print((1 + 2) * 3);
    print(7 / 2);
    print(-7 / 2);
    print(7 % 3);
    print(-7 % 3);
    print(7 % -3);
    print(10 - 20);
    print(9223372036854775807);
    print(-9223372036854775807 - 1);
    print(0x1F + 1_000);
    print(2.5 * 4.0);
    print(1.0 / 3.0);
    print(0.1 + 0.2);
    print(1.0 / 0.0);
    print(-1.0 / 0.0);
    print(0.0 / 0.0);
    print(1.5e3);
    print(float(7) / 2.0);
    print(int(-3.99));
    print(int(3.99));
}
